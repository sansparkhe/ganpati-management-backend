# ---------------------------------------------------------------------------
# Copy this file to `.env` and edit the values. NEVER commit the real `.env`.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# ------------------------------- application -------------------------------
APP_NAME="Ganpati Utsav Management API"
APP_VERSION=1.0.0
APP_ENV=development          # development | staging | production | test
DEBUG=true                   # set to false in production (hides error details)
API_PREFIX=/api

# --------------------------------- database --------------------------------
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# psycopg3 is used for BOTH the async app and the sync Alembic migrations,
# so this single URL is all you need.
DATABASE_URL=postgresql+psycopg://ganpati_user:change_me@localhost:5432/ganpati_db

# Optional. Overrides DATABASE_URL for the app/tests. The pytest suite defaults
# to in-memory SQLite, so you do NOT need this to run the tests.
# TEST_DATABASE_URL=postgresql+psycopg://ganpati_user:change_me@localhost:5432/ganpati_test

SQL_ECHO=false               # true prints every SQL statement (noisy)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ----------------------------------- cors ----------------------------------
# Comma separated. Only matters for Flutter Web / browser clients — Android and
# iOS builds do not send an Origin header. Never use "*" in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOW_CREDENTIALS=false

# --------------------------------- society ---------------------------------
# "<WING>:<flat count>" pairs. This is the ONLY place the flat structure is
# defined; the seed script and all validation read it from here.
#
#   !! KNOWN DISCREPANCY - PLEASE CONFIRM !!
#   A:12,B:12 produces 24 flats (A1..A12, B1..B12) but the original
#   requirement says 28. Nothing in the code assumes either number.
#   GET /api/flats/config reports the mismatch until the two agree.
#
#   To reach 28 flats pick ONE of:
#     SOCIETY_WINGS=A:14,B:14       -> A1..A14, B1..B14
#     SOCIETY_WINGS=A:12,B:12,C:4   -> adds a C wing
#   ...then re-run `python -m scripts.seed` (safe to run repeatedly).
#   If 24 is actually correct, set EXPECTED_TOTAL_FLATS=24 instead.
SOCIETY_WINGS=A:12,B:12
EXPECTED_TOTAL_FLATS=28

# -------------------------------- behaviour --------------------------------
ALLOW_FUTURE_DATES=false     # true allows post-dated collections/expenses
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
RECENT_ITEMS_LIMIT=5         # rows in "recent" lists on dashboard/finance
CURRENCY_CODE=INR
CURRENCY_SYMBOL=₹
